# Secret used to sign the Vault session cookie (any long random string)
AUTH_SECRET=

# Password required to unlock the Vault (/str)
SITE_PASSWORD=

# Vercel Blob read/write token (from your Vercel project's Storage tab)
BLOB_READ_WRITE_TOKEN=

# Google Apps Script endpoint that returns the contributed-beatmaps feed as JSON
BEATMAP_FEED_URL=

# Google Apps Script endpoint that receives the contact form submission (doPost)
CONTACT_FORM_SCRIPT=

# Optional: Google Apps Script endpoint (doGet) that returns the contact form
# sheet as JSON, for the "Messages" tab inside the Vault. If your
# CONTACT_FORM_SCRIPT already handles GET against the same sheet, you can
# leave this unset — it falls back to CONTACT_FORM_SCRIPT automatically.
CONTACT_MESSAGES_FEED_URL=
