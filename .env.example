# Secret used to sign the Vault session cookie (any long random string)
AUTH_SECRET=

# Password required to unlock the Vault (/str)
SITE_PASSWORD=

# Vercel Blob read/write token (from your Vercel project's Storage tab)
BLOB_READ_WRITE_TOKEN=

# Google Apps Script endpoint that returns the contributed-beatmaps feed as JSON
BEATMAP_FEED_URL=

# Google Apps Script endpoint that receives the contact form submission
CONTACT_FORM_SCRIPT=
